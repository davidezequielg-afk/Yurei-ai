{
  "name": "yurei",
  "version": "1.5.0",
  "description": "Asistente de voz de escritorio de código abierto con Gemini: isla en pantalla, dictado, Circle to Ask, rutinas y control del escritorio.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "predist": "node scripts/fetch-voices.js",
    "dist": "electron-builder --win nsis --publish never",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "author": "Yurei contributors",
  "build": {
    "appId": "com.yurei.assistant",
    "productName": "Yurei",
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "extraResources": [
      {
        "from": "build-voices",
        "to": "voices"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Yurei-Setup-${version}.${ext}"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "sherpa-onnx-node": "2.0.0"
  }
}
